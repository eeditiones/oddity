{
  "name": "oddity",
  "displayName": "ODDity",
  "description": "Companion to TEI Publisher and opm: author TEI and other XML with schema-aware checking and suggestions, write presentation rules in ODD following the TEI Processing Model, and preview the result.",
  "version": "0.6.0",
  "publisher": "e-editiones",
  "repository": {
    "type": "git",
    "url": "https://github.com/eeditiones/oddity.git"
  },
  "bugs": {
    "url": "https://github.com/eeditiones/oddity/issues"
  },
  "homepage": "https://github.com/eeditiones/oddity#readme",
  "license": "GPL-3.0-or-later",
  "icon": "media/oddity_icon.png",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "TEI",
    "ODD",
    "XML",
    "TEI Publisher"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:xml",
    "workspaceContains:**/*.odd",
    "workspaceContains:**/opm.toml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "xml",
        "extensions": [
          ".odd"
        ]
      },
      {
        "id": "jinks",
        "aliases": [
          "Jinks Template",
          "jinks"
        ],
        "extensions": [
          ".tpl"
        ],
        "configuration": "./syntaxes/jinks.language-configuration.json"
      },
      {
        "id": "jinks-css",
        "aliases": [
          "Jinks CSS Template"
        ],
        "filenamePatterns": [
          "*.css.tpl"
        ],
        "configuration": "./syntaxes/jinks.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jinks",
        "scopeName": "text.html.jinks",
        "path": "./syntaxes/jinks-html.tmLanguage.json",
        "embeddedLanguages": {
          "source.css": "css",
          "source.js": "javascript",
          "meta.embedded.block.json": "json"
        }
      },
      {
        "language": "jinks-css",
        "scopeName": "source.css.jinks",
        "path": "./syntaxes/jinks-css.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.json": "json"
        }
      },
      {
        "scopeName": "jinks.injection",
        "path": "./syntaxes/jinks.injection.tmLanguage.json",
        "injectTo": [
          "text.html.jinks",
          "source.css.jinks"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "oddity.graphicalEditor",
        "displayName": "ODD Graphical Editor",
        "selector": [
          {
            "filenamePattern": "*.odd"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "oddity.openGraphicalEditor",
        "title": "Open Graphical Editor",
        "category": "ODDity",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "oddity.addElementSpec",
        "title": "Add <elementSpec>",
        "category": "ODDity",
        "icon": "$(add)"
      },
      {
        "command": "oddity.recompileOdd",
        "title": "Recompile ODD on server",
        "category": "ODDity",
        "icon": "$(sync)"
      },
      {
        "command": "oddity.findElementSpec",
        "title": "Go to elementSpec",
        "category": "ODDity",
        "icon": "$(search)"
      },
      {
        "command": "oddity.openGraphicalEditorAtElementSpec",
        "title": "Open elementSpec in Graphical Editor",
        "category": "ODDity",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "oddity.opmPreview",
        "title": "Open opm Preview to the Side",
        "category": "ODDity",
        "icon": "$(open-preview)"
      },
      {
        "command": "oddity.opmPreviewCollection",
        "title": "Preview Collection with opm",
        "category": "ODDity"
      },
      {
        "command": "oddity.opmRestart",
        "title": "Restart opm Preview Process",
        "category": "ODDity"
      },
      {
        "command": "oddity.opmMaximize",
        "title": "Maximize Preview",
        "category": "ODDity",
        "icon": "$(screen-full)"
      },
      {
        "command": "oddity.opmRestore",
        "title": "Restore Editor Layout",
        "category": "ODDity",
        "icon": "$(screen-normal)"
      },
      {
        "command": "oddity.compileOddToRng",
        "title": "Compile ODD to RELAX NG",
        "category": "ODDity",
        "icon": "$(file-binary)"
      },
      {
        "command": "oddity.associateSchema",
        "title": "Associate with Schema…",
        "category": "ODDity"
      },
      {
        "command": "oddity.surroundWithElement",
        "title": "Surround with Element…",
        "category": "ODDity"
      },
      {
        "command": "oddity.selectElement",
        "title": "Select Element",
        "category": "ODDity"
      },
      {
        "command": "oddity.splitElement",
        "title": "Split Element",
        "category": "ODDity"
      },
      {
        "command": "oddity.removeElementTags",
        "title": "Remove Element Tags",
        "category": "ODDity"
      }
    ],
    "keybindings": [
      {
        "command": "oddity.findElementSpec",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == oddity.graphicalEditor"
      },
      {
        "command": "oddity.surroundWithElement",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "editorTextFocus && editorLangId == xml && !editorReadonly"
      },
      {
        "command": "oddity.selectElement",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && editorLangId == xml"
      },
      {
        "command": "oddity.splitElement",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId == xml && !editorReadonly"
      },
      {
        "command": "oddity.removeElementTags",
        "key": "ctrl+shift+x",
        "mac": "cmd+shift+x",
        "when": "editorTextFocus && editorLangId == xml && !editorReadonly"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "oddity.openGraphicalEditor",
          "when": "resourceExtname == .odd && activeCustomEditorId != oddity.graphicalEditor",
          "group": "navigation"
        },
        {
          "command": "oddity.recompileOdd",
          "when": "resourceExtname == .odd && oddity.canRecompileOdd",
          "group": "navigation"
        },
        {
          "command": "oddity.opmPreview",
          "when": "resourceExtname == .xml && oddity.inOpmProject",
          "group": "navigation"
        },
        {
          "command": "oddity.opmMaximize",
          "when": "activeWebviewPanelId == oddity.opmPreview && !editorPartMaximizedEditorGroup",
          "group": "navigation"
        },
        {
          "command": "oddity.opmRestore",
          "when": "activeWebviewPanelId == oddity.opmPreview && editorPartMaximizedEditorGroup",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "oddity.openGraphicalEditor",
          "when": "resourceExtname == .odd",
          "group": "navigation"
        },
        {
          "command": "oddity.opmPreview",
          "when": "resourceExtname == .xml",
          "group": "navigation"
        },
        {
          "command": "oddity.opmPreviewCollection",
          "when": "explorerResourceIsFolder && resourcePath in oddity.opmCollections",
          "group": "navigation"
        },
        {
          "command": "oddity.compileOddToRng",
          "when": "resourceExtname == .odd",
          "group": "7_schema"
        },
        {
          "command": "oddity.associateSchema",
          "when": "resourceExtname == .xml",
          "group": "7_schema"
        }
      ],
      "editor/context": [
        {
          "command": "oddity.openGraphicalEditor",
          "when": "resourceExtname == .odd && editorLangId == xml && activeCustomEditorId != oddity.graphicalEditor",
          "group": "navigation"
        },
        {
          "command": "oddity.openGraphicalEditorAtElementSpec",
          "when": "resourceExtname == .odd && editorLangId == xml && oddity.cursorInElementSpec",
          "group": "navigation"
        },
        {
          "command": "oddity.addElementSpec",
          "when": "resourceExtname == .odd && editorLangId == xml",
          "group": "1_modification"
        },
        {
          "command": "oddity.recompileOdd",
          "when": "resourceExtname == .odd && oddity.canRecompileOdd",
          "group": "1_modification"
        },
        {
          "command": "oddity.compileOddToRng",
          "when": "resourceExtname == .odd && editorLangId == xml",
          "group": "1_modification"
        },
        {
          "command": "oddity.associateSchema",
          "when": "resourceExtname == .xml && editorLangId == xml",
          "group": "1_modification"
        },
        {
          "submenu": "oddity.element",
          "when": "editorLangId == xml",
          "group": "1_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "oddity.opmPreviewCollection",
          "when": "false"
        },
        {
          "command": "oddity.opmMaximize",
          "when": "false"
        },
        {
          "command": "oddity.opmRestore",
          "when": "false"
        },
        {
          "command": "oddity.openGraphicalEditor",
          "when": "resourceExtname == .odd"
        },
        {
          "command": "oddity.addElementSpec",
          "when": "resourceExtname == .odd && editorLangId == xml"
        },
        {
          "command": "oddity.recompileOdd",
          "when": "resourceExtname == .odd && oddity.canRecompileOdd"
        },
        {
          "command": "oddity.findElementSpec",
          "when": "activeCustomEditorId == oddity.graphicalEditor"
        },
        {
          "command": "oddity.openGraphicalEditorAtElementSpec",
          "when": "resourceExtname == .odd && editorLangId == xml && oddity.cursorInElementSpec"
        },
        {
          "command": "oddity.opmPreview",
          "when": "resourceExtname == .xml && oddity.inOpmProject"
        },
        {
          "command": "oddity.compileOddToRng",
          "when": "resourceExtname == .odd"
        },
        {
          "command": "oddity.associateSchema",
          "when": "editorLangId == xml && resourceExtname != .odd"
        },
        {
          "command": "oddity.surroundWithElement",
          "when": "editorLangId == xml"
        },
        {
          "command": "oddity.selectElement",
          "when": "editorLangId == xml"
        },
        {
          "command": "oddity.splitElement",
          "when": "editorLangId == xml"
        },
        {
          "command": "oddity.removeElementTags",
          "when": "editorLangId == xml"
        }
      ],
      "oddity.element": [
        {
          "command": "oddity.surroundWithElement",
          "group": "1_element@1"
        },
        {
          "command": "oddity.selectElement",
          "group": "1_element@2"
        },
        {
          "command": "oddity.splitElement",
          "group": "1_element@3"
        },
        {
          "command": "oddity.removeElementTags",
          "group": "1_element@4"
        }
      ]
    },
    "configuration": {
      "title": "ODDity",
      "properties": {
        "oddity.editorFontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Font size in pixels for the input fields and code fields of the graphical ODD editor. `0` uses `#editor.fontSize#`."
        },
        "oddity.opm.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path of the `opm` command used by the opm preview. Empty: `opm` on the PATH, or the one `uv tool install open-processing-model` put in `~/.local/bin`."
        },
        "oddity.opm.python": {
          "type": "string",
          "default": "",
          "markdownDescription": "Python interpreter that has opm installed, for the opm preview. Takes precedence over `#oddity.opm.path#`; use it when opm lives in a virtual environment."
        },
        "oddity.opm.defaultMode": {
          "type": "string",
          "enum": [
            "web",
            "print",
            "markdown",
            "chunk",
            "typst"
          ],
          "default": "web",
          "markdownDescription": "Output mode a new opm preview starts with. `typst` needs the typst command; without it the preview starts with `web`."
        },
        "oddity.opm.typst": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path of the `typst` command, for the preview's typst mode. Empty: `typst` on the PATH, or in `/opt/homebrew/bin`, `/usr/local/bin`, `~/.cargo/bin` or `~/.local/bin`."
        },
        "oddity.xml.autoCloseTags": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Insert the end tag when a start tag is finished with `>`, and complete `</` with the name of the open element."
        }
      }
    },
    "configurationDefaults": {
      "[xml]": {
        "editor.linkedEditing": true
      }
    },
    "submenus": [
      {
        "id": "oddity.element",
        "label": "Element"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --minify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xml-tools/ast": "^5.0.5",
    "@xml-tools/parser": "^1.0.11"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.91.0",
    "@vscode/codicons": "^0.0.45",
    "esbuild": "^0.20.0",
    "lit": "^3.3.3",
    "marked": "^15.0.12",
    "marked-footnote": "^1.4.0",
    "oddity-language-server": "file:../oddity-language-server",
    "pagedjs": "^0.4.3",
    "typescript": "^5.4.0",
    "vscode-languageclient": "^11.0.0"
  }
}
