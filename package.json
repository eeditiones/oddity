{
  "name": "oddity",
  "displayName": "ODDity",
  "description": "Authoring support for ODD files: an ODD-aware outline and graphical editor for TEI Processing Model output transformations.",
  "version": "0.6.0",
  "publisher": "e-editiones",
  "repository": {
    "type": "git",
    "url": "https://github.com/eeditiones/oddity.git"
  },
  "bugs": {
    "url": "https://github.com/eeditiones/oddity/issues"
  },
  "homepage": "https://github.com/eeditiones/oddity#readme",
  "license": "GPL-3.0-or-later",
  "icon": "media/oddity_icon.png",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "TEI",
    "ODD",
    "XML",
    "TEI Publisher"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "redhat.vscode-xml"
  ],
  "activationEvents": [
    "onLanguage:xml",
    "workspaceContains:**/*.odd"
  ],
  "contributes": {
    "languages": [
      {
        "id": "xml",
        "extensions": [
          ".odd"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "oddity.graphicalEditor",
        "displayName": "ODD Graphical Editor",
        "selector": [
          {
            "filenamePattern": "*.odd"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "oddity.openGraphicalEditor",
        "title": "Open Graphical Editor",
        "category": "ODD",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "oddity.addElementSpec",
        "title": "Add <elementSpec>",
        "category": "ODD",
        "icon": "$(add)"
      },
      {
        "command": "oddity.recompileOdd",
        "title": "Recompile ODD on server",
        "category": "ODD",
        "icon": "$(sync)"
      },
      {
        "command": "oddity.findElementSpec",
        "title": "Go to elementSpec",
        "category": "ODD",
        "icon": "$(search)"
      },
      {
        "command": "oddity.openGraphicalEditorAtElementSpec",
        "title": "Open elementSpec in Graphical Editor",
        "category": "ODD",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "oddity.opmPreview",
        "title": "Open opm Preview to the Side",
        "category": "opm",
        "icon": "$(open-preview)"
      },
      {
        "command": "oddity.opmRestart",
        "title": "Restart opm Preview Process",
        "category": "opm"
      },
      {
        "command": "oddity.opmMaximize",
        "title": "Maximize Preview",
        "category": "opm",
        "icon": "$(screen-full)"
      },
      {
        "command": "oddity.opmRestore",
        "title": "Restore Editor Layout",
        "category": "opm",
        "icon": "$(screen-normal)"
      }
    ],
    "keybindings": [
      {
        "command": "oddity.findElementSpec",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == oddity.graphicalEditor"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "oddity.openGraphicalEditor",
          "when": "resourceExtname == .odd && activeCustomEditorId != oddity.graphicalEditor",
          "group": "navigation"
        },
        {
          "command": "oddity.recompileOdd",
          "when": "resourceExtname == .odd && oddity.canRecompileOdd",
          "group": "navigation"
        },
        {
          "command": "oddity.opmPreview",
          "when": "resourceExtname == .xml && oddity.inOpmProject",
          "group": "navigation"
        },
        {
          "command": "oddity.opmMaximize",
          "when": "activeWebviewPanelId == oddity.opmPreview && !editorPartMaximizedEditorGroup",
          "group": "navigation"
        },
        {
          "command": "oddity.opmRestore",
          "when": "activeWebviewPanelId == oddity.opmPreview && editorPartMaximizedEditorGroup",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "oddity.openGraphicalEditor",
          "when": "resourceExtname == .odd",
          "group": "navigation"
        },
        {
          "command": "oddity.opmPreview",
          "when": "resourceExtname == .xml",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "oddity.openGraphicalEditor",
          "when": "resourceExtname == .odd && editorLangId == xml && activeCustomEditorId != oddity.graphicalEditor",
          "group": "navigation"
        },
        {
          "command": "oddity.openGraphicalEditorAtElementSpec",
          "when": "resourceExtname == .odd && editorLangId == xml && oddity.cursorInElementSpec",
          "group": "navigation"
        },
        {
          "command": "oddity.addElementSpec",
          "when": "resourceExtname == .odd && editorLangId == xml",
          "group": "1_modification"
        },
        {
          "command": "oddity.recompileOdd",
          "when": "resourceExtname == .odd && oddity.canRecompileOdd",
          "group": "1_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "oddity.opmMaximize",
          "when": "false"
        },
        {
          "command": "oddity.opmRestore",
          "when": "false"
        },
        {
          "command": "oddity.openGraphicalEditor",
          "when": "resourceExtname == .odd"
        },
        {
          "command": "oddity.addElementSpec",
          "when": "resourceExtname == .odd && editorLangId == xml"
        },
        {
          "command": "oddity.recompileOdd",
          "when": "resourceExtname == .odd && oddity.canRecompileOdd"
        },
        {
          "command": "oddity.findElementSpec",
          "when": "activeCustomEditorId == oddity.graphicalEditor"
        },
        {
          "command": "oddity.openGraphicalEditorAtElementSpec",
          "when": "resourceExtname == .odd && editorLangId == xml && oddity.cursorInElementSpec"
        },
        {
          "command": "oddity.opmPreview",
          "when": "resourceExtname == .xml && oddity.inOpmProject"
        }
      ]
    },
    "configuration": {
      "title": "ODDity",
      "properties": {
        "oddity.autoBindSchema": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Automatically bind the bundled `teipublisher_odds.xsd` schema to `.odd` files (via `xml.fileAssociations`) when they do not already reference a resolvable schema through an `xml-model` processing instruction."
        },
        "oddity.editorFontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Font size in pixels for the input fields and code fields of the graphical ODD editor. `0` uses `#editor.fontSize#`."
        },
        "oddity.opm.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path of the `opm` command used by the opm preview. Empty: `opm` on the PATH, or the one `uv tool install open-processing-model` put in `~/.local/bin`."
        },
        "oddity.opm.python": {
          "type": "string",
          "default": "",
          "markdownDescription": "Python interpreter that has opm installed, for the opm preview. Takes precedence over `#oddity.opm.path#`; use it when opm lives in a virtual environment."
        },
        "oddity.opm.defaultMode": {
          "type": "string",
          "enum": ["web", "print", "markdown", "chunk"],
          "default": "web",
          "markdownDescription": "Output mode a new opm preview starts with."
        }
      }
    },
    "configurationDefaults": {
      "xml.symbols.filters": [
        {
          "pattern": "**/*.odd",
          "expressions": [
            {
              "xpath": "//*",
              "excluded": true
            }
          ]
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --minify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xml-tools/ast": "^5.0.5",
    "@xml-tools/parser": "^1.0.11"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.84.0",
    "@vscode/codicons": "^0.0.45",
    "esbuild": "^0.20.0",
    "lit": "^3.3.3",
    "marked": "^15.0.12",
    "marked-footnote": "^1.4.0",
    "pagedjs": "^0.4.3",
    "typescript": "^5.4.0"
  }
}
